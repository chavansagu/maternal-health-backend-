@"
# Environment / secrets
.env
.env.*
!.env.example

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/

# Logs
logs/
*.log
nohup.out

# Database backups / local data
database_backup/

# Local test files
test_file/

# OS files
.DS_Store
Thumbs.db

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Coverage
.coverage
htmlcov/

# Temporary files
*.tmp
*.temp
"@ | Set-Content .gitignore